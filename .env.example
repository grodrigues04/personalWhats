# MongoDB Atlas (mesma URI em todos os projetos que usam a interface)
MONGO_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/
# Senha de criptografia das mensagens. Guarde num gerenciador de senhas: é a senha do botão
# "Descriptografar" do frontend e de todos os projetos que enviam mensagens
ENCRYPTION_PASSWORD=
# Contato usado quando a mensagem não informa destinatário (DDI + DDD + número)
DEFAULT_RECIPIENT=
